      "weight": 4,
      "seed_gpu_map": {
        "42": 0,
        "3407": 5,
        "2026": 6
      },
      "enabled": true,
      "main_table": true,
      "description": "Final TaskSegment: episode visual prototypes during training and fixed K=4 training-support prototypes for validation/test; no large prototype-bank blending."
    },
    {
      "name": "tasksegment_with_prototype_bank",
      "family": "tasksegment",
      "variant": "with_prototype_bank",
      "env": "TS",
      "input_size": [
        512,
        512
