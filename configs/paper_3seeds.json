  "paths": {
    "clipseg_model": "./pretrained/clipseg-rd64-refined",
    "lvit_repo": "./third_party/LViT",
    "lvit_text_encoder": "./pretrained/bert-base-uncased",
    "sammed2d_repo": "./third_party/SAM-Med2D",
    "sammed2d_checkpoint": "./pretrained/sam-med2d/sam-med2d_b.pth",
    "transunet_pretrained": "./pretrained/transunet/R50+ViT-B_16.npz"
  },
  "experiments": [
    {
      "name": "tasksegment_full",
      "family": "tasksegment",
      "variant": "full",
      "env": "TS",
      "input_size": [
        512,
        512
