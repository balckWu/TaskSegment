      "weight": 4,
      "seed_gpu_map": {
        "42": 0,
        "3407": 5,
        "2026": 6
      },
      "enabled": false,
      "main_table": false,
      "description": "Supplementary optional 128-support domain prototype bank with scheduled blending."
    },
    {
      "name": "tasksegment_no_semantic_text",
      "family": "tasksegment",
      "variant": "no_semantic_text",
      "env": "TS",
      "input_size": [
        512,
        512
      ],
      "weight": 4,
      "seed_gpu_map": {
        "42": 0,
        "3407": 5,
        "2026": 6
      },
      "enabled": false,
      "main_table": false,
      "description": "Supplementary: removes BioBERT semantic vectors only; domain and group embeddings remain."
    },
    {
      "name": "tasksegment_no_text_conditioning",
      "family": "tasksegment",
      "variant": "no_text_conditioning",
      "env": "TS",
      "input_size": [
        512,
        512
      ],
      "weight": 4,
      "allowed_gpus": [
        0,
        1,
        4,
        5,
        6
      ],
      "enabled": true,
      "main_table": false,
      "description": "Main ablation: removes BioBERT semantics, domain embeddings, and group embeddings while preserving five zero condition-token slots."
    },
    {
      "name": "tasksegment_no_prototype_bank_blending",
      "family": "tasksegment",
      "variant": "no_prototype_bank_blending",
      "env": "TS",
      "input_size": [
        512,
        512
      ],
      "weight": 4,
      "seed_gpu_map": {
        "42": 0,
        "3407": 5,
        "2026": 6
      },
      "enabled": false,
      "main_table": false,
