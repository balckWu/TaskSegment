{
  "schema_version": 6,
  "project_name": "TaskSegment_MIA_3Seeds_V6_NoBankFull",
  "artifacts_root": "./paper_artifacts",
  "database": "./paper_artifacts/experiment_results.sqlite",
  "protocol": {
    "data_root": "./data",
    "text_dir": "./text_features_llm",
    "seeds": [
      42,
      3407,
      2026
    ],
    "gpus": [
      0,
      1,
      2,
      4,
      5,
      6
    ],
    "batch_size": 4,
    "val_batch_size": 4,
    "grad_accum_steps": 4,
    "effective_batch_size": 16,
    "episodes_per_epoch": 1500,
    "epochs": 150,
    "warmup_epochs": 5,
    "patience": 20,
    "threshold": 0.5,
    "metric_size": [
      512,
      512
    ],
    "domain_sampling_alpha": 0.0,
    "deterministic": true,
    "amp": true,
    "cache_dataset": true,
    "preload_val_cache": true,
    "preload_test_cache": true,
    "postprocess": false,
    "progress": "off",
    "monitor_interval_seconds": 30,
    "prototype_blend_target": 0.9,
    "prototype_warmup_epochs": 5,
    "prototype_ramp_epochs": 10,
    "prototype_refresh_samples": 128,
    "prototype_eval_support_samples": 4,
    "prototype_refresh_batch_size": 4,
    "prototype_refresh_interval": 1,
    "prototype_bank_blending_default": false
